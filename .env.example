# Get your Merchant Code from the Verifone/2Checkout Control Panel (Setup -> Account details).
# It is not secret and is safe to expose to the client — it just identifies your store.
TWOCHECKOUT_MERCHANT_CODE=your-merchant-code

# SANDBOX for testing with a demo account, PRODUCTION to accept real payments.
TWOCHECKOUT_MODE=SANDBOX

# Optional: override the port the server listens on.
PORT=3000
